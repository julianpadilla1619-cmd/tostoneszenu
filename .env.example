# Tostones Zenú — variables de entorno
# Copia como .env.local (desarrollo) y configúralas en Vercel (producción).

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Solo servidor. NUNCA exponer en el navegador.
SUPABASE_SERVICE_ROLE_KEY=

# URL pública del sitio (enlaces en correos, recuperación de contraseña, WhatsApp)
NEXT_PUBLIC_SITE_URL=https://tu-proyecto.vercel.app

# Notificaciones push. Generar con: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:correo@ejemplo.com

# Recordatorio automático (Vercel Cron). Texto largo y aleatorio.
CRON_SECRET=

# Correo (opcional) — https://resend.com
RESEND_API_KEY=
EMAIL_FROM=Tostones Zenú <avisos@tu-dominio.com>
