# Copia este archivo como .env.local y completa los valores (F1: conexión a Supabase).
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Solo servidor (Server Actions / Edge Functions). Nunca exponer en el cliente.
SUPABASE_SERVICE_ROLE_KEY=

# Web Push (F4). Generar con: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@tostoneszenu.com
